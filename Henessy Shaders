-- // NOTIFICATION SYSTEM //
local function Notify(text)
	local N = create("Frame", {Size = UDim2.new(0, 280, 0, 60), Position = UDim2.new(0, -320, 0, 30), BackgroundColor3 = THEME.Background, Parent = NotifGui, ZIndex = 100})
	create("UICorner", {CornerRadius = UDim.new(0, 10), Parent = N})
	create("UIStroke", {Color = THEME.Accent, Thickness = 1.5, Parent = N})
	create("TextLabel", {Text = text, Size = UDim2.new(1, -20, 1, 0), Position = UDim2.new(0, 15, 0, 0), BackgroundTransparency = 1, TextColor3 = THEME.TextPrimary, Font = THEME.FontBold, TextSize = 14, TextXAlignment = "Left", Parent = N, ZIndex = 101})
	
	TweenService:Create(N, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = UDim2.new(0, 20, 0, 30)}):Play()
	task.delay(4, function()
		if not N or not N.Parent then return end
		local out = TweenService:Create(N, TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(0, -320, 0, 30)})
		out:Play() out.Completed:Connect(function() N:Destroy() end)
	end)
end

