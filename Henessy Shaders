	if IsBinding and i.UserInputType == Enum.UserInputType.Keyboard then
		ToggleKey = i.KeyCode KeybindBtn.Text = i.KeyCode.Name IsBinding = false return
	end
	if not p and i.KeyCode == ToggleKey then ToggleMenu() end 
end)
