-- // SHADER HANDLER //
local function CleanSpecialShaders()
    if LiquidConn then LiquidConn:Disconnect() LiquidConn = nil end
    if LiquidPart then LiquidPart:Destroy() LiquidPart = nil end
    if Lighting:FindFirstChild("RivalsGlow") then Lighting.RivalsGlow:Destroy() end
end

-- // RENDERER //
local currentTab = "BRIGHT / CLEAN"
local function renderShaders()
	for _, child in pairs(Scroll:GetChildren()) do if child:IsA("Frame") then child:Destroy() end end
	local query = SearchInput.Text:lower()
	
	local list = {}
	if currentTab == "FAVORITES" then
		for _, cat in pairs(SHADER_TABS) do
			for _, s in pairs(cat) do if table.find(Favorites, s.Name) then table.insert(list, s) end end
		end
	else
		list = SHADER_TABS[currentTab] or {}
	end

	for _, data in pairs(list) do
		if query == "" or data.Name:lower():find(query) then
			local Row = create("Frame", {Size = UDim2.new(1, 0, 0, 60), BackgroundColor3 = THEME.Secondary, Parent = Scroll, ZIndex = 14})
			create("UICorner", {Parent = Row})
			create("TextLabel", {Text = data.Name, Position = UDim2.new(0, 15, 0, 12), Size = UDim2.new(0.5, 0, 0, 20), TextColor3 = THEME.TextPrimary, Font = THEME.FontBold, TextSize = 16, BackgroundTransparency = 1, TextXAlignment = "Left", Parent = Row, ZIndex = 15})
			create("TextLabel", {Text = data.Desc, Position = UDim2.new(0, 15, 0, 32), Size = UDim2.new(0.5, 0, 0, 15), TextColor3 = THEME.TextSecondary, Font = THEME.Font, TextSize = 11, BackgroundTransparency = 1, TextXAlignment = "Left", Parent = Row, ZIndex = 15})
			
			local Btn = create("TextButton", {Text = "ENABLE", Size = UDim2.new(0, 80, 0, 30), Position = UDim2.new(1, -95, 0.5, -15), BackgroundColor3 = Color3.fromRGB(30, 30, 35), TextColor3 = THEME.Accent, Font = THEME.FontBold, TextSize = 11, Parent = Row, ZIndex = 16})
			create("UICorner", {CornerRadius = UDim.new(0, 6), Parent = Btn})
			
            Btn.MouseButton1Click:Connect(function() 
				SelTitle.Text = data.Name
				CleanSpecialShaders() -- Clean up previous effects
                
                if data.Set.Type == "Special" then
                    if data.Set.Mode == "DarkGlow" then
                        Lighting.Brightness = 0
                        Lighting.Ambient = Color3.fromRGB(0, 0, 0)
                        local bloom = Instance.new("BloomEffect", Lighting)
                        bloom.Name = "RivalsGlow"
                        bloom.Intensity = 2.5
                        bloom.Size = 24
                        bloom.Threshold = 0.05
                        local cc = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect", Lighting)
                        cc.Saturation = -0.1
                        cc.Contrast = 0.6
                        cc.TintColor = Color3.fromRGB(180, 180, 255)
                    elseif data.Set.Mode == "Liquid" then
                        LiquidPart = Instance.new("Part")
                        LiquidPart.Transparency = 0.98
                        LiquidPart.Material = Enum.Material.Glass
                        LiquidPart.CanCollide = false
                        LiquidPart.Anchored = true
                        LiquidPart.Size = Vector3.new(10, 10, 10)
                        LiquidPart.Parent = Camera
                        LiquidConn = RunService.RenderStepped:Connect(function()
                            if LiquidPart then
                                local wobble = CFrame.Angles(math.sin(tick()*2)*0.04, math.cos(tick()*2)*0.04, 0)
                                LiquidPart.CFrame = Camera.CFrame * CFrame.new(0,0,-1.2) * wobble
                            end
                        end)
                    end
                else
                    local ti = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                    local CC = Lighting:FindFirstChildOfClass("ColorCorrectionEffect") or Instance.new("ColorCorrectionEffect", Lighting)
                    TweenService:Create(Lighting, ti, {ClockTime = data.Set.Time, Brightness = data.Set.Bright}):Play()
                    TweenService:Create(CC, ti, {Saturation = data.Set.Sat, Contrast = data.Set.Con, TintColor = data.Set.Color}):Play()
                    local bloom = Lighting:FindFirstChildOfClass("BloomEffect") or Instance.new("BloomEffect", Lighting)
                    TweenService:Create(bloom, ti, {Intensity = data.Set.Bloom}):Play()
                end
			end)

			local isFav = table.find(Favorites, data.Name)
			local FavBtn = create("TextButton", {Text = isFav and "★" or "☆", Size = UDim2.new(0, 45, 0, 45), Position = UDim2.new(1, -150, 0.5, -22), BackgroundTransparency = 1, TextColor3 = THEME.Accent, Font = THEME.FontBold, TextSize = 32, Parent = Row, ZIndex = 16})
			FavBtn.MouseButton1Click:Connect(function()
				local idx = table.find(Favorites, data.Name)
				if idx then table.remove(Favorites, idx) FavBtn.Text = "☆" else table.insert(Favorites, data.Name) FavBtn.Text = "★" end
				SaveFavorites() if currentTab == "FAVORITES" then renderShaders() end
			end)
		end
	end
	Scroll.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y)
end

-- // ANIMATION & TOGGLE //
local currentTween = nil
local function ToggleMenu()
	IsMenuOpen = not IsMenuOpen
	if currentTween then currentTween:Cancel() end 

	if IsMenuOpen then
		if not HasPlayedSound then
			OpenSound:Play()
			HasPlayedSound = true 
			task.delay(3, function() if OpenSound then OpenSound:Stop() end end)
		end
		
		Main.Visible = true
		local ti = TweenInfo.new(0.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		currentTween = TweenService:Create(Main, ti, {Size = MenuSize, Position = UDim2.new(0.5, -400, 0.5, -360)})
		currentTween:Play()
		TweenService:Create(Corner, ti, {CornerRadius = UDim.new(0, 12)}):Play()
	else
		local ti = TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
		currentTween = TweenService:Create(Main, ti, {Size = UDim2.new(0,0,0,0), Position = UDim2.new(0.5,0,0.5,0)})
		currentTween:Play() 
		currentTween.Completed:Connect(function() 
			if not IsMenuOpen then Main.Visible = false end
		end)
	end
end

